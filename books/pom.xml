<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.hypercube.workshop</groupId>
    <artifactId>books</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <!-- Typst project root: the parent of the shared `common` directory.
             It MUST be given to typst, otherwise a book cannot import `../common`
             ("cannot read file outside of the project root"). -->
        <typst.root>${project.basedir}/src/main/typst</typst.root>

        <!-- Name of the PDF produced for each book (written in target/).
             Change these properties to rename a book without touching its sources. -->
        <book.kurzweil.pdf>kurzweil-sysex-guide.pdf</book.kurzweil.pdf>
        <book.se-02.pdf>roland-se02-sysex-guide.pdf</book.se-02.pdf>
        <book.akai-mpk-261.pdf>akai-mpk-261-sysex-guide.pdf</book.akai-mpk-261.pdf>
        <book.ds-330.pdf>boss-ds-330-sysex-guide.pdf</book.ds-330.pdf>

        <!-- Name of the JPEG cover (first page of the PDF above) written in
             site/docs/assets/, where the Docsify site shows it. -->
        <book.kurzweil.cover>kurzweil-sysex-guide-cover.jpg</book.kurzweil.cover>
        <book.se-02.cover>roland-se02-sysex-guide-cover.jpg</book.se-02.cover>
        <book.akai-mpk-261.cover>akai-mpk-261-sysex-guide-cover.jpg</book.akai-mpk-261.cover>
        <book.ds-330.cover>boss-ds-330-sysex-guide-cover.jpg</book.ds-330.cover>

        <!-- Which books are compiled. Every book compiles by default, which is what
             CI and the release need. The `only-*` profiles below turn the other 3 off,
             so a work session on one book does not pay for them:

                 mvn -Ponly-akai package         # akai-mpk261 alone
                 mvn -Ponly-kurzweil package     # kurzweil alone
                 mvn -Ponly-se-02 package        # se-02 alone
                 mvn -Ponly-ds-330 package       # ds-330 alone

             The switches are plain properties, so they can also be set by hand:
             mvn "-Dbook.kurzweil.skip=true" "-Dbook.se-02.skip=true" package
             (quote them in PowerShell: an unquoted -Dname.value is cut at the dot) -->
        <book.kurzweil.skip>false</book.kurzweil.skip>
        <book.se-02.skip>false</book.se-02.skip>
        <book.akai-mpk-261.skip>false</book.akai-mpk-261.skip>
        <book.ds-330.skip>false</book.ds-330.skip>
        <!-- Abstract SVG backgrounds, generated by src/main/generator/GenerateSvgBackgrounds.java
             at the initialize phase. Same seed = same files, so a rebuild never changes them.
             Override from the command line: mvn -Dsvg.seed=42 -Dsvg.blue.accent=#00aaff ... -->
        <svg.seed>2481</svg.seed>
        <!-- Debug mode: black background, front mesh in red, back mesh in blue,
             no transparency, boundary curves drawn. Never enable it for a release. -->
        <svg.debug>false</svg.debug>
        <svg.themes>blue,red,green,purple</svg.themes>
        <svg.out>${project.basedir}/src/main/typst/common/assets/generated</svg.out>
        <!-- The generator keeps a .stamp of the properties and of its own source:
             when nothing changed it rewrites nothing, and `mvn clean` keeps the folder
             (it is a cache). `-Dsvg.force=true` forces a regeneration. -->
        <svg.force>false</svg.force>
        <!-- Skip the artwork step entirely. The generated files are only rebuilt when
             the stamp says their inputs changed, but the check still pays a Java
             startup (~1.5 s). A book that does not change its artwork can skip the
             step: mvn "-Dsvg.skip=true" package. The compile fails when the folder is
             missing, so run a normal build on a fresh checkout. -->
        <svg.skip>false</svg.skip>

        <!-- Per-theme seed offset: each book keeps its own grid, while the output stays
             reproducible. Same offset = same geometry. -->
        <svg.blue.seed>0</svg.blue.seed>
        <svg.red.seed>17</svg.red.seed>
        <svg.green.seed>42</svg.green.seed>
        <svg.purple.seed>71</svg.purple.seed>

        <svg.blue.base>#0e2a47</svg.blue.base>
        <svg.blue.deep>#00459e</svg.blue.deep>
        <svg.blue.line>#03305d</svg.blue.line>
        <svg.blue.accent>#3379c2</svg.blue.accent>
        <svg.blue.spark>#3fe0a0</svg.blue.spark>

        <svg.red.base>#2b070d</svg.red.base>
        <svg.red.deep>#4a0b16</svg.red.deep>
        <svg.red.line>#5a0b18</svg.red.line>
        <svg.red.accent>#c8102e</svg.red.accent>
        <svg.red.spark>#ffb020</svg.red.spark>

        <svg.green.base>#0c3323</svg.green.base>
        <svg.green.deep>#123a2b</svg.green.deep>
        <svg.green.line>#06402a</svg.green.line>
        <svg.green.accent>#34a86c</svg.green.accent>
        <svg.green.spark>#7fe0c0</svg.green.spark>

        <svg.purple.base>#1b0b33</svg.purple.base>
        <svg.purple.deep>#331260</svg.purple.deep>
        <svg.purple.line>#3c1468</svg.purple.line>
        <svg.purple.accent>#7a3bd6</svg.purple.accent>
        <svg.purple.spark>#c9a2ff</svg.purple.spark>

        <!-- Book cover thumbnails: the first page of each PDF rendered as a JPEG
             by Apache PDFBox (see GenerateBookCovers.java), for the Docsify site.
             The output goes straight into site/docs/assets/ so midi-sysex.md can
             reference it without any extra copy step in the CI workflow. -->
        <cover.out>${project.basedir}/../site/docs/assets</cover.out>
        <cover.dpi>150</cover.dpi>
        <cover.quality>0.85</cover.quality>
        <cover.max-width>800</cover.max-width>
        <!-- Skip the cover step. Safe when the books did not change and the JPEGs
             already exist, but unlike the SVG step it has no stamp: a normal build
             re-renders the 4 covers every time. -->
        <cover.skip>false</cover.skip>
    </properties>

    <!-- Apache PDFBox renders the first page of each PDF as a JPEG (cover
         thumbnail for the Docsify site). This is a `pom` module, so the
         dependency is not built into anything: the dependency-plugin below
         copies it (and its transitive jars) into target/cover-lib, and the
         exec-plugin runs GenerateBookCovers.java on that classpath. -->
    <dependencies>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.8</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.2.0</version>
                <!-- The generated artwork lives in src/, not in target/, and it is NOT
                     removed by `mvn clean`: it is a cache. The generator compares the
                     svg.* properties and its own source with generated/.stamp, so a
                     clean build reuses the pictures instead of paying for them again.
                     Use `-Dsvg.force=true` (or delete the folder) to rebuild them. -->
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-cover-libs</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/cover-lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>generate-svg-backgrounds</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <executable>${java.home}/bin/java</executable>
                            <skip>${svg.skip}</skip>
                            <arguments>
                                <argument>-Dsvg.seed=${svg.seed}</argument>
                                <argument>-Dsvg.debug=${svg.debug}</argument>
                                <argument>-Dsvg.force=${svg.force}</argument>
                                <argument>-Dsvg.script=${project.basedir}/src/main/generator/GenerateSvgBackgrounds.java</argument>
                                <argument>-Dsvg.themes=${svg.themes}</argument>
                                <argument>-Dsvg.out=${svg.out}</argument>
                                <argument>-Dsvg.blue.seed=${svg.blue.seed}</argument>
                                <argument>-Dsvg.blue.base=${svg.blue.base}</argument>
                                <argument>-Dsvg.blue.deep=${svg.blue.deep}</argument>
                                <argument>-Dsvg.blue.line=${svg.blue.line}</argument>
                                <argument>-Dsvg.blue.accent=${svg.blue.accent}</argument>
                                <argument>-Dsvg.blue.spark=${svg.blue.spark}</argument>
                                <argument>-Dsvg.red.seed=${svg.red.seed}</argument>
                                <argument>-Dsvg.red.base=${svg.red.base}</argument>
                                <argument>-Dsvg.red.deep=${svg.red.deep}</argument>
                                <argument>-Dsvg.red.line=${svg.red.line}</argument>
                                <argument>-Dsvg.red.accent=${svg.red.accent}</argument>
                                <argument>-Dsvg.red.spark=${svg.red.spark}</argument>
                                <argument>-Dsvg.green.seed=${svg.green.seed}</argument>
                                <argument>-Dsvg.green.base=${svg.green.base}</argument>
                                <argument>-Dsvg.green.deep=${svg.green.deep}</argument>
                                <argument>-Dsvg.green.line=${svg.green.line}</argument>
                                <argument>-Dsvg.green.accent=${svg.green.accent}</argument>
                                <argument>-Dsvg.green.spark=${svg.green.spark}</argument>
                                <argument>-Dsvg.purple.seed=${svg.purple.seed}</argument>
                                <argument>-Dsvg.purple.base=${svg.purple.base}</argument>
                                <argument>-Dsvg.purple.deep=${svg.purple.deep}</argument>
                                <argument>-Dsvg.purple.line=${svg.purple.line}</argument>
                                <argument>-Dsvg.purple.accent=${svg.purple.accent}</argument>
                                <argument>-Dsvg.purple.spark=${svg.purple.spark}</argument>
                                <argument>${project.basedir}/src/main/generator/GenerateSvgBackgrounds.java</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- One execution per book: the entry point is always
                         <book>/main.typ, the PDF name comes from the properties above.

                         The flag `no-pdf-tags` (see the arguments below) removes the
                         accessibility tags: Typst tags the PDF (structure tree for
                         screen readers) by default, which accounts for ~2/3 of the
                         file (2.5 MB -> 0.9 MB for the AKAI book). The bookmarks, the
                         links and the text stay; only the tagging goes. Drop the flag
                         if a PDF/UA build is ever needed. -->
                    <execution>
                        <id>compile-kurzweil</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${project.build.directory}</workingDirectory>
                            <executable>typst</executable>
                            <skip>${book.kurzweil.skip}</skip>
                            <arguments>
                                <argument>compile</argument>
                                <argument>--no-pdf-tags</argument>
                                <argument>--root</argument>
                                <argument>${typst.root}</argument>
                                <argument>${typst.root}/kurzweil/main.typ</argument>
                                <argument>${book.kurzweil.pdf}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-se-02</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${project.build.directory}</workingDirectory>
                            <executable>typst</executable>
                            <skip>${book.se-02.skip}</skip>
                            <arguments>
                                <argument>compile</argument>
                                <argument>--no-pdf-tags</argument>
                                <argument>--root</argument>
                                <argument>${typst.root}</argument>
                                <argument>${typst.root}/roland-se-02/main.typ</argument>
                                <argument>${book.se-02.pdf}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-akai-mpk-261</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${project.build.directory}</workingDirectory>
                            <executable>typst</executable>
                            <skip>${book.akai-mpk-261.skip}</skip>
                            <arguments>
                                <argument>compile</argument>
                                <argument>--no-pdf-tags</argument>
                                <argument>--root</argument>
                                <argument>${typst.root}</argument>
                                <argument>${typst.root}/akai-mpk261/main.typ</argument>
                                <argument>${book.akai-mpk-261.pdf}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-ds-330</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${project.build.directory}</workingDirectory>
                            <executable>typst</executable>
                            <skip>${book.ds-330.skip}</skip>
                            <arguments>
                                <argument>compile</argument>
                                <argument>--no-pdf-tags</argument>
                                <argument>--root</argument>
                                <argument>${typst.root}</argument>
                                <argument>${typst.root}/boss-ds-330/main.typ</argument>
                                <argument>${book.ds-330.pdf}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Renders the first page of each PDF as a JPEG (Apache PDFBox),
                         for the Docsify site. Runs after the PDFs above (generate-resources)
                         and after the PDFBox jars have been copied (process-resources). -->
                    <execution>
                        <id>generate-book-covers</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <executable>${java.home}/bin/java</executable>
                            <skip>${cover.skip}</skip>
                            <arguments>
                                <argument>-cp</argument>
                                <argument>${project.build.directory}/cover-lib/*</argument>
                                <argument>-Dcover.kurzweil.pdf=${project.build.directory}/${book.kurzweil.pdf}</argument>
                                <argument>-Dcover.kurzweil.jpg=${cover.out}/${book.kurzweil.cover}</argument>
                                <argument>-Dcover.se-02.pdf=${project.build.directory}/${book.se-02.pdf}</argument>
                                <argument>-Dcover.se-02.jpg=${cover.out}/${book.se-02.cover}</argument>
                                <argument>-Dcover.akai.pdf=${project.build.directory}/${book.akai-mpk-261.pdf}</argument>
                                <argument>-Dcover.akai.jpg=${cover.out}/${book.akai-mpk-261.cover}</argument>
                                <argument>-Dcover.ds-330.pdf=${project.build.directory}/${book.ds-330.pdf}</argument>
                                <argument>-Dcover.ds-330.jpg=${cover.out}/${book.ds-330.cover}</argument>
                                <argument>-Dcover.dpi=${cover.dpi}</argument>
                                <argument>-Dcover.quality=${cover.quality}</argument>
                                <argument>-Dcover.max-width=${cover.max-width}</argument>
                                <argument>${project.basedir}/src/main/generator/GenerateBookCovers.java</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- One profile per book of the repository: it turns the 2 others off.
         Without a profile, the 4 books compile, which keeps CI and the release
         unchanged. `mvn package` in a work session on 1 book:

             mvn -Ponly-akai package -->
    <profiles>
        <profile>
            <id>only-kurzweil</id>
            <properties>
                <book.se-02.skip>true</book.se-02.skip>
                <book.akai-mpk-261.skip>true</book.akai-mpk-261.skip>
                <book.ds-330.skip>true</book.ds-330.skip>
            </properties>
        </profile>
        <profile>
            <id>only-se-02</id>
            <properties>
                <book.kurzweil.skip>true</book.kurzweil.skip>
                <book.akai-mpk-261.skip>true</book.akai-mpk-261.skip>
                <book.ds-330.skip>true</book.ds-330.skip>
            </properties>
        </profile>
        <profile>
            <id>only-akai</id>
            <properties>
                <book.kurzweil.skip>true</book.kurzweil.skip>
                <book.se-02.skip>true</book.se-02.skip>
                <book.ds-330.skip>true</book.ds-330.skip>
            </properties>
        </profile>
        <profile>
            <id>only-ds-330</id>
            <properties>
                <book.kurzweil.skip>true</book.kurzweil.skip>
                <book.se-02.skip>true</book.se-02.skip>
                <book.akai-mpk-261.skip>true</book.akai-mpk-261.skip>
            </properties>
        </profile>
    </profiles>
</project>
