<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.hypercube.workshop</groupId>
    <artifactId>books</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <!-- Typst project root: the parent of the shared `common` directory.
             It MUST be given to typst, otherwise a book cannot import `../common`
             ("cannot read file outside of the project root"). -->
        <typst.root>${project.basedir}/src/main/typst</typst.root>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <!-- One execution per book. The PDFs are written in target/ -->
                    <execution>
                        <id>compile-kurzweil-format</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${project.build.directory}</workingDirectory>
                            <executable>typst</executable>
                            <arguments>
                                <argument>compile</argument>
                                <argument>--root</argument>
                                <argument>${typst.root}</argument>
                                <argument>${typst.root}/kurzweil-format/kurzweil-format.typ</argument>
                                <argument>kurzweil-format.pdf</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-se-02-format</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${project.build.directory}</workingDirectory>
                            <executable>typst</executable>
                            <arguments>
                                <argument>compile</argument>
                                <argument>--root</argument>
                                <argument>${typst.root}</argument>
                                <argument>${typst.root}/se-02-format/se-02-format.typ</argument>
                                <argument>se-02-format.pdf</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
