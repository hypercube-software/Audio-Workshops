# -------------------------------------------
# Memory Layout Roland/Boss DS-330
# -------------------------------------------

@Model Boss DS-330
@Packed

# -------------------------------------------
# Memory zones
# -------------------------------------------
@400000-000100 SystemParams Zone
{
	SystemParams
}

@400100-001000 CommonPatchParams Zone
{
	CommonPatchParams
}

@401000-002000 PatchParams Zone
{
	PatchParams[16 block]
}

@402000-002000 PatchSends Zone
{
	PatchSends[16 block]
}

@403000-000020 Information Zone
{
	String Information[32]
}

@410000-00000C Drum Map 1 Name
{
	String Name[12]
}
@411000-00000C Drum Map 2 Name
{
	String Name[12]
}

@410100 Drum Map 1
{
	DrumMapSetting
}

@411100 Drum Map 2
{
	DrumMapSetting
}

@480000-001D10 NIBBLES Bulk Dump
{
    BulkSystemParams
    BulkCommonPatchParams
    byte reserved[14]
    BulkPatchParams[16 block]
}
# ------------------------------------------------
# MAP 1
# ------------------------------------------------
@490000 NIBBLES Bulk DrumMap1 Key
{
	byte Key[128]
}
@490200 NIBBLES Bulk DrumMap1 Level
{
	byte Level[128]
}
@490400 NIBBLES Bulk DrumMap1 Group
{
	byte Group[128]
}
@490600 NIBBLES Bulk DrumMap1 Pan
{
	byte Pan[128]
}
@490800 NIBBLES Bulk DrumMap1 Reverb
{
	byte Reverb[128]
}
@490A00 NIBBLES Bulk DrumMap1 Chorus
{
	byte Chorus[128]
}
@490C00 NIBBLES Bulk DrumMap1 Rx Note
{
	byte Rx Note[128]
}
@490E00 NIBBLES Bulk DrumMap1 Name
{
	String Name[12]
}
# ------------------------------------------------
# MAP 2
# ------------------------------------------------

@491000 NIBBLES Bulk DrumMap2 Key
{
	byte Key[128]
}
@491200 NIBBLES Bulk DrumMap2 Level
{
	byte Level[128]
}
@491400 NIBBLES Bulk DrumMap2 Group
{
	byte Group[128]
}
@491600 NIBBLES Bulk DrumMap2 Pan
{
	byte Pan[128]
}
@491800 NIBBLES Bulk DrumMap2 Reverb
{
	byte Reverb[128]
}
@491A00 NIBBLES Bulk DrumMap2 Chorus
{
	byte Chorus[128]
}
@491C00 NIBBLES Bulk DrumMap2 Rx Note
{
	byte Rx Note[128]
}
@491E00 NIBBLES Bulk DrumMap2 Name
{
	String Name[12]
}
# -------------------------------------------
struct SystemParams
{
	int  Master Tune
	byte Master Volume
	byte Master Key Shift
	byte Master Pan
	byte reserved[120]
	byte GS Reset # reads 0x42 (GS mode marker); writing 00 resets to the factory GS state
}
struct 000100 CommonPatchParams
{
	String Name[16]
	byte Voice Reserve[16]
	byte unknown # key 0x20 (undocumented, 0-15)
	byte reserved[15]
	ReverbType Reverb Type # key 0x30 (Room 1 .. Panning Delay)
	byte Reverb Character # key 0x31
	byte Reverb Pre LPF # key 0x32
	byte Reverb Level
	byte Reverb Time
	byte Reverb Delay Feedback
	byte Reverb Send Level to Chorus
	byte reserved[1]
	ChorusType Chorus Type # key 0x38 (Chorus 1 .. Short Delay FB)
	byte Chorus Pre LPF
	byte Chorus Level
	byte Chorus Feedback
	byte Chorus Delay
	byte Chorus Rate
	byte Chorus Depth
	byte Chorus Send Level to Reverb
}
# PatchParams comes in a specific order: block 0 is the drum part (channel 10),
# blocks 1 to 9 are the parts on channels 1 to 9, and blocks A to F are the
# parts on channels 11 to 16.
# The Channel field stores the channel minus 1: the drum block stores 09,
# block 1 stores 00, block 9 stores 08, block A stores 0A, block F stores 0F.

struct ToneParams
{
	byte Vibrato Rate
	byte Vibrato Depth
	byte TVF Cutoff
	byte TVF Resonance
	byte Attack
	byte Decay
	byte Release
	byte Vibrato Delay
}

struct 000100 PatchParams
{
	short Tone Command and Program Change
	byte Channel
	Switch Rx Pitch Bend
	Switch Rx Channel Aftertouch
	Switch Rx Program Change
	Switch Rx Control Change
	Switch Rx Polyphonic Aftertouch
	Switch Rx Note Message
	Switch Rx RPN
	Switch Rx NRPN
	Switch Rx Modulation
	Switch Rx Volume
	Switch Rx Panpot
	Switch Rx Expression
	Switch Rx Hold 1
	Switch Rx Portamento
	Switch Rx Sostenuto
	Switch Rx Soft
	byte Mono Poly Mode
	byte Assign Mode
	byte Use for Rhythm Part
	byte Pitch Key Shift
	short Pitch Offset Fine
	byte Level
	byte Velocity Sense Depth
	byte Velocity Sense Offset
	byte Part Panpot
	byte Note range low
	byte Note range high
	byte CC1
	byte CC2
	byte Chorus Send Level
	byte Reverb Send Level
	byte reserved[13]

	ToneParams
	
	byte reserved[8]

	0C Scale Tuning
}
struct 000100 PatchSends
{
    Send MOD
    Send BEND
    Send CAF
    Send PAF
    Send CC1
    Send CC2
}
struct Send
{
	byte Pitch Control
	byte TVF
	byte TVA
	LFOSend LFO1
	LFOSend LFO2
	byte reserved[5]
}
struct LFOSend
{
	byte Rate
	byte Pitch
	byte TVF
	byte TVA
}
struct DrumMapSetting
{
    byte Play Note Number[128 Note]
	byte Level[128 Note]
	byte Assign Group[128 Note]
	byte Pan[128 Note]
	byte Reverb[128 Note]
	byte Chorus[128 Note]
	Switch Rx Note Off[128 Note]
	Switch Rx Note On[128 Note]
}
# -------------------------------------------
# Bulk types
# -------------------------------------------
struct BulkSystemParams
{
	short  Master Tune # 0400 mean 00040000, apparently it is NOT in NIBBLE but we don't handle this craziness
	byte   Master Volume
	byte   unknown
	byte GS Reset # reads 0x42 (GS mode marker)
	byte   Master Key Shift
	byte   Master Pan
	byte   unknown
}

struct BulkCommonPatchParams
{
	String Name[16]
	byte Voice Reserve[16 block]
	byte unknown # key 0x20 -> bulk 40 (undocumented)
	byte reserved # bulk 41
	ReverbType Reverb Type # key 0x30 -> bulk 42
	byte Reverb Character # key 0x31 -> bulk 43
	byte Reverb Pre LPF # key 0x32 -> bulk 44
	byte Reverb Level
	byte Reverb Time
	byte Reverb Delay Feedback
	byte Reverb Send Level to Chorus
	byte reserved # bulk 49
	ChorusType Chorus Type # key 0x38 -> bulk 50
	byte Chorus Pre LPF
	byte Chorus Level
	byte Chorus Feedback
	byte Chorus Delay
	byte Chorus Rate
	byte Chorus Depth
	byte Chorus Send Level to Reverb
}
struct BulkToneParams
{
	byte Vibrato Rate
	byte Vibrato Depth
	byte TVF Cutoff
	byte TVF Resonance
	byte Attack
	byte Decay
	byte Release
	byte Vibrato Delay
}

struct BulkPatchParams
{
	short Tone Command and Program Change
	short Rx Mask
	byte Channel
	byte unknown1 # B0 for channel 10, 81 for the other
	byte Pitch Key Shift
	byte Pitch Offset Fine # 80 means 0800, apparently it is NOT in NIBBLE but we don't handle this craziness

	byte Level
	byte Part Panpot
	byte Velocity Sense Depth
	byte Velocity Sense Offset
	byte Note range low
	byte Note range high
	byte Chorus Send Level
	byte Reverb Send Level

	BulkToneParams

    byte unknown
    byte unknown

	0C Scale Tuning

	byte CC1
	byte CC2
	
	BulkSend MOD
    BulkSend BEND
    BulkSend CAF
    BulkSend PAF
    BulkSend CC1
    BulkSend CC2
}

struct BulkSend
{
	byte Pitch
	byte TVF
	byte TVA
    byte reserved

    BulkLFOSend LFO1
    BulkLFOSend LFO2
}

struct BulkLFOSend
{
	byte Rate
	byte Pitch
	byte TVF
	byte TVA
}

# ------------------------------------------------------
# Enums
# ------------------------------------------------------
enum SplitMode
{
	Off
	Split
	Dual
}

enum Switch
{
	Off
	On
}

enum KeyboardMode
{
	MONO
	POLY
}

enum ReverbType
{
	Room 1
	Room 2
	Room 3
	Hall 1
	Hall 2
	Plate
	Delay
	Panning Delay
}

enum ChorusType
{
	Chorus 1
	Chorus 2
	Chorus 3
	Chorus 4
	Feedback Chorus
	Flanger
	Short Delay
	Short Delay FB
}
